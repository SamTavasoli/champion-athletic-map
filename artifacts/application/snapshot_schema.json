{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prototype saved snapshot",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "prototype-snapshot-1"
    },
    "application_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "\\S"
    },
    "exported_at": {
      "type": "string",
      "format": "date-time"
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "\\S"
        },
        "planning_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "public_record": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "profile_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "\\S"
            },
            "schema_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "\\S"
            },
            "input": {
              "type": "object"
            }
          },
          "required": [
            "profile_id",
            "schema_version",
            "input"
          ]
        },
        "saved_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "profile_version",
        "planning_hash",
        "public_record",
        "saved_at"
      ]
    },
    "plan": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "plan_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "\\S"
            },
            "parent_plan_version": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160,
                  "pattern": "\\S"
                },
                {
                  "type": "null"
                }
              ]
            },
            "content_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "profile_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "\\S"
            },
            "profile_planning_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "response": {
              "type": "object"
            },
            "reference_packet_id": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 1024
                },
                {
                  "type": "null"
                }
              ]
            },
            "source_versions": {
              "type": "object",
              "maxProperties": 100,
              "propertyNames": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024,
                "pattern": "\\S"
              },
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 2048
                  },
                  {
                    "type": "integer"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "activity_versions": {
              "type": "object",
              "maxProperties": 500,
              "propertyNames": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "\\S"
              },
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "occurrence_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160,
                    "pattern": "\\S"
                  },
                  "activity_revision": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160,
                    "pattern": "\\S"
                  },
                  "content_hash": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "date": {
                    "type": "string",
                    "format": "date"
                  },
                  "activity": {
                    "type": "object"
                  }
                },
                "required": [
                  "occurrence_id",
                  "activity_revision",
                  "content_hash",
                  "date",
                  "activity"
                ]
              }
            },
            "activity_sources": {
              "type": "object",
              "maxProperties": 500,
              "propertyNames": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "\\S"
              },
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "catalog_id": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 160,
                        "pattern": "\\S"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "catalog_id"
                ]
              }
            },
            "edits": {
              "type": "array",
              "maxItems": 500,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "activity_id": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 160,
                        "pattern": "\\S"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "replacement_activity_id": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 160,
                        "pattern": "\\S"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "replacement_id": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 160,
                        "pattern": "\\S"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "date": {
                    "type": "string",
                    "format": "date"
                  },
                  "start_time": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "end_time": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "duration_minutes": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "before": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "date": {
                        "anyOf": [
                          {
                            "type": "string",
                            "format": "date"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "activity_id": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 160,
                            "pattern": "\\S"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "date",
                      "activity_id"
                    ]
                  },
                  "after": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "date": {
                        "anyOf": [
                          {
                            "type": "string",
                            "format": "date"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "activity_id": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 160,
                            "pattern": "\\S"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "date",
                      "activity_id"
                    ]
                  }
                }
              }
            },
            "saved_at": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "plan_version",
            "parent_plan_version",
            "content_hash",
            "profile_version",
            "profile_planning_hash",
            "response",
            "reference_packet_id",
            "source_versions",
            "activity_versions",
            "activity_sources",
            "edits",
            "saved_at"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "progress": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "occurrence_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "\\S"
          },
          "activity_revision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "\\S"
          },
          "plan_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "\\S"
          },
          "status": {
            "enum": [
              "pending",
              "completed",
              "skipped"
            ]
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "occurrence_id",
          "activity_revision",
          "plan_version",
          "status",
          "updated_at"
        ]
      }
    },
    "progress_history": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "occurrence_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "\\S"
          },
          "activity_revision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "\\S"
          },
          "plan_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "\\S"
          },
          "status": {
            "enum": [
              "pending",
              "completed",
              "skipped"
            ]
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "occurrence_id",
          "activity_revision",
          "plan_version",
          "status",
          "updated_at"
        ]
      }
    },
    "assessments": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "assessment_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "\\S"
          },
          "bindings": {
            "type": "object",
            "maxProperties": 100,
            "propertyNames": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "pattern": "\\S"
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 2048
                },
                {
                  "type": "integer"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "reported_accepted": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "reported_status": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "\\S"
          },
          "saved_at": {
            "type": "string",
            "format": "date-time"
          },
          "historical": {
            "const": true
          }
        },
        "required": [
          "assessment_id",
          "bindings",
          "reported_accepted",
          "reported_status",
          "saved_at",
          "historical"
        ]
      }
    },
    "application_versions": {
      "type": "object",
      "maxProperties": 100,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024,
        "pattern": "\\S"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string",
            "maxLength": 2048
          },
          {
            "type": "integer"
          },
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "application_version",
    "exported_at",
    "profile",
    "plan",
    "progress",
    "progress_history",
    "assessments",
    "application_versions"
  ]
}
