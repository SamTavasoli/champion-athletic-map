{
  "$id": "urn:champion-athletic-map:planner-response-candidate:1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "else": {
        "properties": {
          "weekly_schedule": {
            "maxItems": 0
          }
        }
      },
      "if": {
        "properties": {
          "response_type": {
            "const": "plan"
          }
        }
      },
      "then": {
        "properties": {
          "planning_window": {
            "type": "object"
          },
          "weekly_schedule": {
            "maxItems": 7,
            "minItems": 7
          }
        },
        "required": [
          "planning_window",
          "weekly_schedule"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "response_type": {
            "const": "clarification"
          }
        }
      },
      "then": {
        "properties": {
          "questions": {
            "minItems": 1
          }
        },
        "required": [
          "questions"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "response_type": {
            "const": "constraint_conflict"
          }
        }
      },
      "then": {
        "properties": {
          "unresolved_issues": {
            "minItems": 1
          }
        },
        "required": [
          "unresolved_issues"
        ]
      }
    }
  ],
  "description": "Structural validation only; no factual, feasibility, eligibility or rule-compliance guarantee.",
  "properties": {
    "evidence_refs": {
      "anyOf": [
        {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ]
    },
    "explanation": {
      "minLength": 1,
      "pattern": "\\S",
      "type": "string"
    },
    "food_facts": {
      "anyOf": [
        {
          "items": {
            "additionalProperties": false,
            "properties": {
              "food_id": {
                "anyOf": [
                  {
                    "minLength": 1,
                    "pattern": "\\S",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "source_ref": {
                "anyOf": [
                  {
                    "minLength": 1,
                    "pattern": "\\S",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "statement": {
                "minLength": 1,
                "pattern": "\\S",
                "type": "string"
              }
            },
            "required": [
              "statement"
            ],
            "type": "object"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ]
    },
    "planning_window": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "end_date": {
              "format": "date",
              "type": "string"
            },
            "start_date": {
              "format": "date",
              "type": "string"
            },
            "timezone": {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            }
          },
          "required": [
            "start_date",
            "end_date",
            "timezone"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "questions": {
      "items": {
        "minLength": 1,
        "pattern": "\\S",
        "type": "string"
      },
      "type": "array"
    },
    "response_type": {
      "enum": [
        "plan",
        "clarification",
        "constraint_conflict",
        "outside_scope"
      ]
    },
    "unresolved_issues": {
      "items": {
        "minLength": 1,
        "pattern": "\\S",
        "type": "string"
      },
      "type": "array"
    },
    "weekly_schedule": {
      "items": {
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "activities": {
                  "maxItems": 0
                }
              }
            },
            "then": {
              "properties": {
                "rest_arrangements": {
                  "minLength": 1,
                  "pattern": "\\S",
                  "type": "string"
                }
              }
            }
          }
        ],
        "properties": {
          "activities": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "activity_id": {
                  "minLength": 1,
                  "pattern": "\\S",
                  "type": "string"
                },
                "description": {
                  "minLength": 1,
                  "pattern": "\\S",
                  "type": "string"
                },
                "duration_minutes": {
                  "anyOf": [
                    {
                      "minimum": 0,
                      "type": "integer"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "evidence_refs": {
                  "anyOf": [
                    {
                      "items": {
                        "minLength": 1,
                        "pattern": "\\S",
                        "type": "string"
                      },
                      "type": "array"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "existing_commitment_refs": {
                  "items": {
                    "pattern": "^/existing_commitments/(0|[1-9][0-9]*)$",
                    "type": "string"
                  },
                  "type": "array"
                },
                "relationship": {
                  "additionalProperties": false,
                  "allOf": [
                    {
                      "else": {
                        "properties": {
                          "parent_activity_id": {
                            "type": "null"
                          }
                        }
                      },
                      "if": {
                        "properties": {
                          "kind": {
                            "const": "part_of_activity"
                          }
                        }
                      },
                      "then": {
                        "properties": {
                          "parent_activity_id": {
                            "minLength": 1,
                            "pattern": "\\S",
                            "type": "string"
                          }
                        }
                      }
                    }
                  ],
                  "properties": {
                    "kind": {
                      "enum": [
                        "separate_session",
                        "part_of_activity"
                      ]
                    },
                    "parent_activity_id": {
                      "anyOf": [
                        {
                          "minLength": 1,
                          "pattern": "\\S",
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "kind",
                    "parent_activity_id"
                  ],
                  "type": "object"
                },
                "resources": {
                  "additionalProperties": false,
                  "properties": {
                    "equipment": {
                      "anyOf": [
                        {
                          "items": {
                            "additionalProperties": false,
                            "properties": {
                              "name": {
                                "minLength": 1,
                                "pattern": "\\S",
                                "type": "string"
                              },
                              "quantity": {
                                "anyOf": [
                                  {
                                    "minimum": 0,
                                    "type": "integer"
                                  },
                                  {
                                    "type": "null"
                                  }
                                ]
                              }
                            },
                            "required": [
                              "name",
                              "quantity"
                            ],
                            "type": "object"
                          },
                          "type": "array"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "participants": {
                      "anyOf": [
                        {
                          "minimum": 1,
                          "type": "integer"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "space": {
                      "anyOf": [
                        {
                          "minLength": 1,
                          "pattern": "\\S",
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "equipment",
                    "space",
                    "participants"
                  ],
                  "type": "object"
                },
                "timing": {
                  "anyOf": [
                    {
                      "additionalProperties": false,
                      "properties": {
                        "end_time": {
                          "anyOf": [
                            {
                              "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$",
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "start_time": {
                          "anyOf": [
                            {
                              "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$",
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      },
                      "type": "object"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "activity_id",
                "description",
                "duration_minutes",
                "resources",
                "relationship"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "date": {
            "format": "date",
            "type": "string"
          },
          "rest_arrangements": {
            "anyOf": [
              {
                "minLength": 1,
                "pattern": "\\S",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "date",
          "activities",
          "rest_arrangements"
        ],
        "type": "object"
      },
      "maxItems": 7,
      "type": "array"
    }
  },
  "required": [
    "response_type",
    "explanation"
  ],
  "title": "Shared planner response candidate",
  "type": "object"
}
