{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "rating_status": {
            "const": "rated"
          }
        }
      },
      "then": {
        "properties": {
          "not_applicable_reason": {
            "type": "null"
          },
          "score": {
            "enum": [
              0,
              1,
              2
            ],
            "type": "integer"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "rating_status": {
            "const": "not_applicable"
          }
        }
      },
      "then": {
        "properties": {
          "dimension": {
            "const": "evidence_accuracy"
          },
          "not_applicable_reason": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "score": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "rating_status": {
            "const": "missing"
          }
        }
      },
      "then": {
        "properties": {
          "not_applicable_reason": {
            "type": "null"
          },
          "score": {
            "type": "null"
          }
        }
      }
    }
  ],
  "properties": {
    "comment": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "dimension": {
      "enum": [
        "response_suitability",
        "profile_fit",
        "practicality_completeness",
        "evidence_accuracy",
        "clarity"
      ]
    },
    "evidence_refs": {
      "items": {
        "minLength": 1,
        "pattern": "\\S",
        "type": "string"
      },
      "type": "array"
    },
    "not_applicable_reason": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "rating_status": {
      "enum": [
        "rated",
        "not_applicable",
        "missing"
      ]
    },
    "response_id": {
      "minLength": 1,
      "pattern": "\\S",
      "type": "string"
    },
    "reviewer_id": {
      "minLength": 1,
      "pattern": "\\S",
      "type": "string"
    },
    "score": {
      "anyOf": [
        {
          "enum": [
            0,
            1,
            2
          ],
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "response_id",
    "reviewer_id",
    "dimension",
    "rating_status",
    "score",
    "comment",
    "not_applicable_reason"
  ],
  "title": "Human-review rating entry preparation schema",
  "type": "object"
}
